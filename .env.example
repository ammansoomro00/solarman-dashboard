# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://solar:solar@localhost:5433/solar?schema=public

# Where the dashboard gets its numbers: "solarman" (your real system) or "demo" (sample data)
SOLAR_DATA_SOURCE=demo

# Solarman OpenAPI (only needed when SOLAR_DATA_SOURCE=solarman)
SOLARMAN_BASE_URL=https://globalapi.solarmanpv.com
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=
SOLARMAN_EMAIL=
# Lowercase SHA-256 hex of the Solarman account password
SOLARMAN_PASSWORD_SHA256=
# Only for business/organization accounts
SOLARMAN_ORG_ID=
# Optional: pin a plant; otherwise the first plant on the account is used
SOLARMAN_STATION_ID=

# Minimum minutes between live refreshes from Solarman (the logger reports every ~5 min)
SYNC_INTERVAL_MINUTES=5
